# =============================================================================
# Local development (used by go run . and ./cmd/migrate)
# Copy to `.env` and fill in real values. The .env file is gitignored.
# =============================================================================
DATABASE_URL=postgres://findfore:findfore@localhost:5433/findfore?sslmode=disable
JWT_SECRET=local-dev-secret-not-for-production
# Backend port; Cloud Run overrides this to 8080. 8090 chosen locally to avoid
# common conflicts with other tooling (Traefik, other apps that use 8080).
PORT=8090
GOLF_COURSE_API_KEY=paste-your-key-here

# =============================================================================
# Cloud Run + Cloud SQL — do NOT set locally.
# Cloud Run injects these from Secret Manager via cloudbuild.yaml.
# =============================================================================
# INSTANCE_CONNECTION_NAME=findfore:us-central1:findfore-db
# DB_USER=findfore
# DB_PASS=(from Secret Manager)
# DB_NAME=findfore
